# Panel & Routing
PANEL_DOMAIN=deploy.example.com
BASE_DOMAIN=example.com
ACME_EMAIL=you@example.com

# Security (use alphanumeric strings or escape '$' as '$$' to avoid compose warnings)
ADMIN_PASSWORD=change-me-to-something-long
SECRET_KEY=paste-a-long-random-string

# GitHub App (optional, enables zero-effort repo picker & push auto-deploy)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_WEBHOOK_SECRET=
# Put your downloaded private key in the data folder as github-app.pem or set path:
GITHUB_PRIVATE_KEY_PATH=/data/github-app.pem
# Alternatively, paste the private key PEM directly:
# GITHUB_PRIVATE_KEY=
