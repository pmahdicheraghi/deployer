# --- panel ---
PANEL_DOMAIN=deploy.example.com
# apps are created as <subdomain>.APP_BASE_DOMAIN, e.g. myapp.apps.example.com
APP_BASE_DOMAIN=apps.example.com
ACME_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-to-something-long
SECRET_KEY=paste-a-long-random-string

# --- GitHub App (optional but recommended — leave blank to hide "Connect GitHub") ---
GITHUB_APP_SLUG=your-app-slug
GITHUB_APP_ID=123456
GITHUB_APP_WEBHOOK_SECRET=paste-the-webhook-secret-you-set-on-the-app
# the .pem downloaded from the app's settings page; mounted by docker-compose.yml
GITHUB_APP_PRIVATE_KEY_PATH=/secrets/github-app-private-key.pem
